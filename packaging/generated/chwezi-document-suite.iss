; Generated by desktop_suite_packager.py; source=packaging/desktop-suite.toml; sha256=9c450358c979f7fbe4cd2cf3560b01346123258fda483d1b7c2d07daedf6f4b8
#define ProjectRoot "..\.."
        #define ProductName "Chwezi Document Suite"
        #define ProductVersion "0.2.0"
        #define Publisher "Chwezi Core Systems"
        #define Launcher "ChweziDocumentSuite.exe"

        [Setup]
        AppId={7DAE3891-9E59-42EE-B6D3-B968C4D12C02}
        AppName={#ProductName}
        AppVersion={#ProductVersion}
        AppPublisher={#Publisher}
        DefaultDirName={localappdata}\Programs\{#ProductName}
        DefaultGroupName={#ProductName}
        UninstallDisplayIcon={app}\{#Launcher}
        OutputDir={#ProjectRoot}\release
        OutputBaseFilename=chwezi-document-suite-Setup-0.2.0
        Compression=lzma2
        SolidCompression=yes
        WizardStyle=modern
        PrivilegesRequired=lowest
        ArchitecturesAllowed=x64compatible
        ArchitecturesInstallIn64BitMode=x64compatible
        DisableProgramGroupPage=yes
        SetupIconFile={#ProjectRoot}\static\icons\apps\app-chwezi-document-suite.ico
LicenseFile={#ProjectRoot}\LICENSE

        [Files]
        Source: "{#ProjectRoot}\release\stage\chwezi-document-suite\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

        [Icons]
        Name: "{autoprograms}\{#ProductName}"; Filename: "{app}\{#Launcher}"
        Name: "{autodesktop}\{#ProductName}"; Filename: "{app}\{#Launcher}"; Tasks: desktopicon

        [Tasks]
        Name: "desktopicon"; Description: "Create a desktop shortcut"; GroupDescription: "Additional shortcuts:"

        [Run]
        Filename: "{app}\{#Launcher}"; Description: "Open {#ProductName}"; Flags: nowait postinstall skipifsilent
